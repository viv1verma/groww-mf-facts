# Copy to .env for local development (python api.py reads it).
# On Vercel, set these under Project → Settings → Environment Variables.

# gemini (Google AI Studio free tier) or groq (GroqCloud free tier) or custom
LLM_PROVIDER=gemini
LLM_API_KEY=paste-your-key-here

# Optional: override the provider's default model if it has been retired.
# LLM_MODEL=gemini-3.5-flash
# LLM_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest
# For LLM_PROVIDER=custom, any OpenAI-compatible endpoint:
# LLM_BASE_URL=https://example.com/v1
